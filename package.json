{
  "name": "pokemon-desktop-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Pokémon Desktop Companion — a non-commercial fan-made desktop tamagotchi",
  "type": "module",
  "main": "src/main/main.mjs",
  "scripts": {
    "start": "electron .",
    "assets": "node tools/assets.mjs",
    "assets:verify": "node tools/assets.mjs --only verify",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.mjs\"",
    "shot": "xvfb-run -a electron --no-sandbox tools/screenshot.mjs",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3"
  }
}
