{
  "_comment": "PokeAPI와 공개된 게임 텍스트 덤프(스칼렛·바이올렛 1.0.1, 포켓몬 GO)에 한국어가 없는 포켓몬의 공식 도감 설명. 개발자가 게임에서 직접 옮겨 준 문장이다. text 는 대표 문장(보통 스칼렛), textLabel 은 그 문장의 출처 표시, entries 는 바이올렛 문장과 폼별 문장. 게임이 데이터를 불러올 때 생성 데이터 위에 덮어쓴다(core/data.mjs).",
  "species": {
    "ursaluna-bloodmoon": {
      "text": {
        "ko": "바다를 건너 표착한 땅에서 살아온 결과, 특별한 모습과 능력으로 변화했다."
      },
      "textLabel": {
        "ko": "스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "바이올렛"
          },
          "text": {
            "ko": "쇠처럼 단단해진 진흙으로 몸을 보호하며 어둠 속도 내다보는 왼쪽 눈을 가진 특별한 다투곰."
          }
        }
      ]
    },
    "enamorus": {
      "text": {
        "ko": "바다를 건너 날아와 혹독한 겨울의 끝을 알린다. 자애로움이 히스이 땅에 새로운 생명을 싹틔우게 했다는 전승이 있다."
      },
      "textLabel": {
        "ko": "화신폼"
      },
      "entries": [
        {
          "label": {
            "ko": "영물폼"
          },
          "text": {
            "ko": "여인의 형상에서 변한 모습. 목숨을 함부로 여기는 자가 있으면 운해로부터 나타나서 자비 없는 분노의 벌을 내린다."
          }
        }
      ]
    },
    "walking-wake": {
      "text": {
        "ko": "수수께끼에 둘러싸인 흉포한 생물. 오래된 탐험기에 기록된 물의 괴물의 이름을 따서 명명되었다."
      },
      "textLabel": {
        "ko": "스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "바이올렛"
          },
          "text": {
            "ko": "초고대의 스이쿤이라며 오컬트 잡지에 게재됐던 일러스트와 비슷한 모습을 하고 있다."
          }
        }
      ]
    },
    "iron-leaves": {
      "text": {
        "ko": "오컬트 잡지에서 다뤘던 미래 비리디온의 모습과 많은 특징이 일치한다."
      },
      "textLabel": {
        "ko": "스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "바이올렛"
          },
          "text": {
            "ko": "얼마 없는 목격담에 의하면 눈부시게 빛나는 검으로 큰 나무와 바위를 채 썰듯 베었다고 한다."
          }
        }
      ]
    },
    "dipplin": {
      "text": {
        "ko": "어떤 지역에서만 재배되는 특별한 사과에 의해 진화했다. 두 마리가 하나인 포켓몬이다."
      },
      "textLabel": {
        "ko": "스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "바이올렛"
          },
          "text": {
            "ko": "머리를 내밀고 있는 외미르와 꼬리를 내밀고 있는 내미르가 사과 안에서 서로 도우며 지낸다."
          }
        }
      ]
    },
    "poltchageist": {
      "text": {
        "ko": "다도의 길을 통달하지 못한 채 죽은 다도가의 원통함이 말차에 깃들어서 포켓몬이 되었다고 한다."
      },
      "textLabel": {
        "ko": "가짜배기의 모습 · 스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "가짜배기의 모습 · 바이올렛"
          },
          "text": {
            "ko": "데인차의 리전폼처럼 보이지만 최근 전혀 상관없는 포켓몬이라고 밝혀졌다."
          }
        },
        {
          "label": {
            "ko": "알짜배기의 모습 · 스칼렛"
          },
          "text": {
            "ko": "가루로 이뤄진 몸의 일부를 먹을 것에 뿌린 다음 이것을 핥은 상대의 생기를 빨아들인다."
          }
        },
        {
          "label": {
            "ko": "알짜배기의 모습 · 바이올렛"
          },
          "text": {
            "ko": "상당한 고가의 차통에 깃든 모습. 저렴한 차통과는 차이가 있지만 아마추어는 구분할 수 없다."
          }
        }
      ]
    },
    "sinistcha": {
      "text": {
        "ko": "차로 위장하여 실수로 마셔 버린 상대의 생기를 흡수하려 하나 금방 들통나 버린다."
      },
      "textLabel": {
        "ko": "범작의 모습 · 스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "범작의 모습 · 바이올렛"
          },
          "text": {
            "ko": "민가의 마루 밑이나 선반 구석 등 서늘하고 어두운 곳을 선호한다. 일몰 후에 먹이를 찾아 돌아다닌다."
          }
        },
        {
          "label": {
            "ko": "걸작의 모습 · 스칼렛"
          },
          "text": {
            "ko": "저명한 도공이 만든 훌륭한 찻잔에 깃들였다. 마니아들을 흥분하게 하는 포켓몬이다."
          }
        },
        {
          "label": {
            "ko": "걸작의 모습 · 바이올렛"
          },
          "text": {
            "ko": "머리의 차선을 휘저을수록 에너지가 충전된다. 싸움에 임할 준비를 하는 것이다."
          }
        }
      ]
    },
    "okidogi": {
      "text": {
        "ko": "목에 달린 독소로 된 사슬에 의해 온몸의 근육이 자극을 받아 듬직한 체격으로 변했다."
      },
      "textLabel": {
        "ko": "스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "바이올렛"
          },
          "text": {
            "ko": "쉽게 흥분해 버리는 난폭한 녀석. 목에 달린 사슬을 휘두르며 닥치는 대로 때려 부순다."
          }
        }
      ]
    },
    "munkidori": {
      "text": {
        "ko": "능력을 끌어올리는 독소로 된 사슬에 뇌가 자극을 받아 사이코 파워가 개화했다."
      },
      "textLabel": {
        "ko": "스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "바이올렛"
          },
          "text": {
            "ko": "안전한 장소에서 강한 현기증을 일으키는 염력을 사용해 적을 농락한다."
          }
        }
      ]
    },
    "fezandipiti": {
      "text": {
        "ko": "몸을 휘감고 있는 사슬에서 나오는 독소에 자극을 받아 아름다운 모습과 소리를 손에 넣었다."
      },
      "textLabel": {
        "ko": "스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "바이올렛"
          },
          "text": {
            "ko": "윤기가 흐르는 날개를 펄럭이며 페로몬을 흩뿌리는 것으로 사람과 포켓몬을 매료시킨다."
          }
        }
      ]
    },
    "ogerpon": {
      "text": {
        "ko": "쓰고 있는 가면에 따라 타입이 변한다. 날렵한 움직임과 발차기 기술로 상대를 농락한다."
      },
      "textLabel": {
        "ko": "벽록의 가면 · 스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "벽록의 가면 · 바이올렛"
          },
          "text": {
            "ko": "장난기가 많고 호기심이 왕성하다. 가면에 담긴 타입의 에너지를 끌어올려서 싸운다."
          }
        },
        {
          "label": {
            "ko": "우물의 가면 · 스칼렛"
          },
          "text": {
            "ko": "콸콸 용솟음치는 물처럼 끊임없이 기술을 구사하는 공수 양면에서 뛰어난 모습."
          }
        },
        {
          "label": {
            "ko": "우물의 가면 · 바이올렛"
          },
          "text": {
            "ko": "물의 힘을 끌어올린 모습. 발차기 기술과 덩굴을 이용한 타격을 쉴 새 없이 퍼붓는다."
          }
        },
        {
          "label": {
            "ko": "화덕의 가면 · 스칼렛"
          },
          "text": {
            "ko": "화덕 안에서 타오르는 불꽃처럼 격렬하게 상대를 몰아붙이는 가장 공격적인 모습."
          }
        },
        {
          "label": {
            "ko": "화덕의 가면 · 바이올렛"
          },
          "text": {
            "ko": "불꽃의 힘을 끌어올린 모습. 가시가 난 덩굴을 창을 다루듯 조종하여 적을 꿰뚫는다."
          }
        },
        {
          "label": {
            "ko": "주춧돌의 가면 · 스칼렛"
          },
          "text": {
            "ko": "집을 지탱하는 주춧돌처럼 묵직하게 충격을 받아 내는 방어에 뛰어난 모습."
          }
        },
        {
          "label": {
            "ko": "주춧돌의 가면 · 바이올렛"
          },
          "text": {
            "ko": "바위의 힘을 끌어올린 모습. 튼튼한 돌 같은 상태로 온갖 공격으로부터 몸을 보호한다."
          }
        }
      ]
    },
    "archaludon": {
      "text": {
        "ko": "주위로부터 정전기를 모은다. 네발로 엎드려서 발사하는 빔은 절대적인 위력을 자랑한다."
      },
      "textLabel": {
        "ko": "스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "바이올렛"
          },
          "text": {
            "ko": "산속에서 굴을 파며 먹이를 찾는다. 낙반에 휩쓸려도 아무렇지 않을 정도로 튼튼하다."
          }
        }
      ]
    },
    "hydrapple": {
      "text": {
        "ko": "7마리의 미드라가 꿀엿으로 만든 사과 안에서 지낸다. 가운데에 있는 미드라가 사령탑이다."
      },
      "textLabel": {
        "ko": "스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "바이올렛"
          },
          "text": {
            "ko": "변덕이 심한 미드라들의 집합. 드물게 마음이 맞으면 본래의 힘을 발휘한다."
          }
        }
      ]
    },
    "gouging-fire": {
      "text": {
        "ko": "목격 보고는 매우 드물다. 불기둥을 뿜어내며 날뛰는 모습이 담긴 짧은 영상이 존재한다."
      },
      "textLabel": {
        "ko": "스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "바이올렛"
          },
          "text": {
            "ko": "화석에서 복원된 앤테이라며 오컬트 잡지에 게재됐던 수상한 포켓몬을 닮았다."
          }
        }
      ]
    },
    "raging-bolt": {
      "text": {
        "ko": "털에서 내뿜는 벼락으로 주변을 모조리 태워 버린다고 전해진다. 자세한 정보는 밝혀진 것이 없다."
      },
      "textLabel": {
        "ko": "스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "바이올렛"
          },
          "text": {
            "ko": "오컬트 잡지에 나와 한동안 화제였던 라이코의 선조를 닮았다."
          }
        }
      ]
    },
    "iron-boulder": {
      "text": {
        "ko": "악의 조직에 개조당한 테라키온이라며 괴상한 잡지에서 다뤘던 포켓몬을 닮았다."
      },
      "textLabel": {
        "ko": "스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "바이올렛"
          },
          "text": {
            "ko": "몸은 금속질로 되어 있다고 한다. 이름은 오래된 책에 기록된 정체불명의 물체에서 유래됐다."
          }
        }
      ]
    },
    "iron-crown": {
      "text": {
        "ko": "코바르온 형태의 최신 병기라며 오컬트 잡지에 소개됐던 정체불명의 물체를 닮았다."
      },
      "textLabel": {
        "ko": "스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "바이올렛"
          },
          "text": {
            "ko": "빛나는 칼날을 발사하며 주위의 모든 것을 베어 버렸다고 하나 그 밖의 정보는 전무하여 정체불명이다."
          }
        }
      ]
    },
    "terapagos": {
      "text": {
        "ko": "에너지를 단단한 결정으로 바꾸는 능력으로 몸을 지킨다. 테라스탈의 근원이 되는 포켓몬이다."
      },
      "textLabel": {
        "ko": "노말폼 · 스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "노말폼 · 바이올렛"
          },
          "text": {
            "ko": "고대의 팔데아에 살았으나 지각 변동에 휩쓸려서 멸종된 것으로 여겨져 왔다."
          }
        },
        {
          "label": {
            "ko": "테라스탈폼 · 스칼렛"
          },
          "text": {
            "ko": "위험을 감지하면 테라스탈의 결정으로 튼튼한 등껍질을 만들어 싸움에 대비한다."
          }
        },
        {
          "label": {
            "ko": "테라스탈폼 · 바이올렛"
          },
          "text": {
            "ko": "테라스탈의 등껍질로 상대의 기술을 받으면, 그 에너지를 흡수해서 자신의 것으로 만든다."
          }
        },
        {
          "label": {
            "ko": "스텔라폼 · 스칼렛"
          },
          "text": {
            "ko": "테라스탈 에너지가 이상할 정도로 증폭된 모습. 고대인이 생각하던 세계를 닮았다."
          }
        },
        {
          "label": {
            "ko": "스텔라폼 · 바이올렛"
          },
          "text": {
            "ko": "땅속에 묻혀 있던 모습은 마치 우주에 떠 있는 별 같았다고 오래된 탐험기에 기록되어 있다."
          }
        }
      ]
    },
    "pecharunt": {
      "text": {
        "ko": "욕망과 능력을 끌어올리는 독소로 된 떡을 먹이고 먹은 상대를 사슬로 조종한다."
      },
      "textLabel": {
        "ko": "스칼렛"
      },
      "entries": [
        {
          "label": {
            "ko": "바이올렛"
          },
          "text": {
            "ko": "복숭아처럼 생긴 껍질은 그야말로 맹독의 저장고다. 독이 든 떡을 만들어서 사람과 포켓몬에게 대접한다."
          }
        }
      ]
    }
  }
}
